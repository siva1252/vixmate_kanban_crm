# Django — for live server set DJANGO_DEBUG=False and a unique long DJANGO_SECRET_KEY
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Jenkins secret file ID: vix-leads-backend-env (see deployment/env/backend.env.example)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,leads-api.internal.viximate.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:6018,https://leads.internal.viximate.com,https://www.leads.internal.viximate.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:6018,https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,https://leads-api.internal.viximate.com
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Database — Docker Compose / Jenkins use POSTGRES_HOST=db (container alias)
# Local manage.py against a host Postgres: keep 127.0.0.1
POSTGRES_DB=vix_kanban
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Email (SMTP) — used for OTP and password reset
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@viximate.local

# Auth / OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# Attachments
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,txt,csv

# Media / static
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Docker/Jenkins entrypoint: seed config + team users on start (1/true/yes). Set 0 after go-live.
SEED_ON_STARTUP=1
