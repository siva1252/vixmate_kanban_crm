# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
POSTGRES_DB=viximate_crm
POSTGRES_USER=viximate
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# Use 5433 when running Postgres via docker compose (local Postgres often uses 5432)
POSTGRES_PORT=5433

# Email (SMTP) — used for OTP and password reset
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@viximate.local

# Auth / OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# Attachments
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,txt,csv

# Media / static
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
