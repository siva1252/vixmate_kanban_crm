# Upload to Jenkins as Secret file credential ID: vix-leads-backend-env
# Fill REPLACE_* before upload. Pipeline forces POSTGRES_HOST=db (Docker Postgres).

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=leads-api.internal.viximate.com,localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,http://leads.internal.viximate.com,http://www.leads.internal.viximate.com,http://127.0.0.1:6018,http://localhost:6018
DJANGO_CSRF_TRUSTED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,https://leads-api.internal.viximate.com,http://leads.internal.viximate.com,http://www.leads.internal.viximate.com,http://leads-api.internal.viximate.com,http://127.0.0.1:6018,http://localhost:6018
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Must match the Docker Postgres container created by Jenkins (alias: db)
POSTGRES_DB=vix_kanban
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@viximate.com

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,txt,csv

MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# 1 = seed stages/sources + 5 team logins on every backend start (idempotent; resets seed passwords)
# Set to 0 after go-live once you change passwords
SEED_ON_STARTUP=1
