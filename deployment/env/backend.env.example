# =============================================================================
# Jenkins Secret file credential ID:  vix-leads-backend-env
# =============================================================================
# How to set/update in Jenkins:
#   1. Manage Jenkins → Credentials → (Global) → Add / Update
#   2. Kind: Secret file
#   3. ID:   vix-leads-backend-env   (must match exactly)
#   4. Upload this file filled with real values (no quotes around values)
# =============================================================================

# --- Django (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=leads-api.internal.viximate.com,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,http://leads.internal.viximate.com,http://www.leads.internal.viximate.com,http://127.0.0.1:6018,http://localhost:6018
DJANGO_CSRF_TRUSTED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,https://leads-api.internal.viximate.com,http://leads.internal.viximate.com,http://www.leads.internal.viximate.com,http://leads-api.internal.viximate.com,http://127.0.0.1:6018

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Postgres on Jenkins host (container reaches it via host.docker.internal) ---
POSTGRES_DB=vix_kanban
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# --- Email (OTP / password reset). Console = logs only; switch to SMTP for real mail ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@viximate.com

# --- Auth / OTP ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

# --- Attachments ---
ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,txt,csv

# --- Paths (relative to /app in the container — do not use absolute /app/...) ---
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
