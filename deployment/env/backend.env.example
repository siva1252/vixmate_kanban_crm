# Copy → Jenkins credential ID: vix-leads-backend-env
# Do NOT commit real secrets. Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=leads-api.internal.viximate.com,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,http://leads.internal.viximate.com,http://www.leads.internal.viximate.com,http://127.0.0.1:6018
DJANGO_CSRF_TRUSTED_ORIGINS=https://leads.internal.viximate.com,https://www.leads.internal.viximate.com,https://leads-api.internal.viximate.com

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Local Postgres on the Jenkins / app host (not a cloud DB)
POSTGRES_DB=vix_kanban
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@viximate.com

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

ATTACHMENT_MAX_SIZE_MB=10
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,xls,xlsx,txt,csv

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
