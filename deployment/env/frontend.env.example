# =============================================================================
# Jenkins Secret file credential ID:  vix-leads-frontend-env
# =============================================================================
# How to set/update in Jenkins:
#   1. Manage Jenkins → Credentials → (Global) → Add / Update
#   2. Kind: Secret file
#   3. ID:   vix-leads-frontend-env   (must match exactly)
#   4. Upload this file (one line is enough)
#
# NOTE: NEXT_PUBLIC_API_URL is baked into the Next.js client at BUILD time.
# After changing this credential, re-run the pipeline so frontend rebuilds.
# =============================================================================

# Browser → public API domain (production)
NEXT_PUBLIC_API_URL=https://leads-api.internal.viximate.com

# If HTTPS/TLS is not ready yet, use HTTP instead:
# NEXT_PUBLIC_API_URL=http://leads-api.internal.viximate.com

# Smoke / same-host only (not for real users behind the domain):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:6019
